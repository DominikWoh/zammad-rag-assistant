# ============================================
# Zammad → LightRAG Configuration
# ============================================
# Copy: cp .env.example .env
# Edit: Fill in your values, then: docker compose up -d

# --- Zammad ---
ZAMMAD_URL=http://localhost:8080
# API token: Zammad → Profile → Token Access → "ticket.agent" permission
ZAMMAD_TOKEN=your_token_here

# --- LLM Backend ---
# Binding: "ollama" or "openai" (for LM Studio / OpenAI-compatible APIs)
LLM_BINDING=openai
# Backend URL:
#   Ollama:      http://host.docker.internal:11434
#   LM Studio:   http://host.docker.internal:1234/v1
LLM_BINDING_HOST=http://host.docker.internal:1234/v1
# API key (required for openai binding; use "lm-studio" for LM Studio)
OPENAI_API_KEY=lm-studio
# LLM model name (must exist in your backend)
LLM_MODEL=google/gemma-3-27b-it
# Embedding model
EMBEDDING_MODEL=text-embedding-bge-m3
# Embedding dimensions (1024 for bge-m3)
EMBEDDING_DIM=1024
# VLM model for image/PDF OCR (optional, leave empty to disable)
VLM_MODEL=

# --- Sync Settings ---
# Only sync tickets closed at least N days ago
TICKET_MIN_AGE_DAYS=7
# Only sync tickets created after this date (YYYY-MM-DD)
START_DATE=2020-01-01
# Sync frequency: hourly, daily, weekly
SYNC_INTERVAL=daily
# Time of day for sync (24h format, HH:MM) — only for daily/weekly
SYNC_TIME=02:00
